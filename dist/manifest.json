{
  "manifest_version": 3,
  "name": "Freak Filler",
  "version": "1.3.3",
  "description": "Automatically fill form data based on your expectations.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["css/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "html/popup.html"
  }
  ,
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
